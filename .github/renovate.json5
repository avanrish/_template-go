{
  extends: ["config:recommended", "helpers:pinGitHubActionDigests"],
  schedule: [
    'before 5am on the first day of the month',
  ],
  // Give the ecosystem time to spot and yank a compromised release.
  minimumReleaseAge: '3 days',
  minimumReleaseAgeBehaviour: 'timestamp-required',
  internalChecksFilter: 'strict',
  // Commit messages must pass committed: Conventional Commits, capitalized.
  semanticCommits: 'enabled',
  commitMessageLowerCase: 'never',
  configMigration: true,
  dependencyDashboard: true,
  // Find vulnerable dependencies through OSV, which includes the Go
  // vulnerability database, instead of relying on Dependabot alerts.
  osvVulnerabilityAlerts: true,
  // Security fixes skip the schedule and the waiting period.
  vulnerabilityAlerts: {
    schedule: ['at any time'],
    minimumReleaseAge: null,
  },
  postUpdateOptions: ['gomodTidy'],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.github/actions/setup/action\\.yaml$/',
      ],
      matchStrings: [
        'version:\\s*"(?<currentValue>\\d+\\.\\d+\\.\\d+)"\\s*# MISE_VERSION',
      ],
      depNameTemplate: 'mise',
      packageNameTemplate: 'jdx/mise',
      datasourceTemplate: 'github-releases',
      extractVersionTemplate: '^v(?<version>.*)$',
    },
  ],
  packageRules: [
    {
      // go.mod and mise.toml pin the same Go version; update them together.
      groupName: 'Go',
      matchDepNames: ['go'],
    },
    {
      // committed is pinned in mise.toml and committed.yaml; update them together.
      groupName: 'committed',
      matchPackageNames: ['crate-ci/committed', 'committed'],
    },
    {
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      groupName: 'compatible (actions)',
    },
    {
      matchManagers: ['mise'],
      matchDepNames: ['!go', '!committed'],
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'compatible (mise)',
    },
  ],
}
